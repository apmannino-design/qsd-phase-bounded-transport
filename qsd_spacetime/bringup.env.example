# Copy to bringup.env and source before starting daemon + agent.
#   set -a; source bringup.env; set +a

export QSD_STATE_DIR="${QSD_STATE_DIR:-$(pwd)/state}"
export QSD_HW_SAMPLE_PATH="${QSD_STATE_DIR}/hw_sample.json"
export QSD_HW_CMD_PATH="${QSD_STATE_DIR}/hw_commands.jsonl"
export QSD_HW_HOOK_LOG="${QSD_STATE_DIR}/hw_hooks.log"

# Example hooks (replace with real terminal binaries)
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]:-$0}")" && pwd)"
export QSD_HW_OFFLOAD_CMD="${ROOT}/hooks/offload.sh"
export QSD_HW_RELOCK_CMD="${ROOT}/hooks/relock.sh"
export QSD_HW_POINT_CMD="${ROOT}/hooks/point.sh"

# Staging agent placeholders (fill from Aalyria)
export STAGING_AGENT_ID="${STAGING_AGENT_ID:-}"
export STAGING_DOMAIN="${STAGING_DOMAIN:-}"
export STAGING_AGENT_EMAIL="${STAGING_AGENT_EMAIL:-}"
export STAGING_PRIVATE_KEY_ID="${STAGING_PRIVATE_KEY_ID:-}"
export STAGING_PRIVATE_KEY_PEM="${STAGING_PRIVATE_KEY_PEM:-}"
export QSD_SPACETIME_ROOT="${ROOT}"

# Telemetry: strict DORMANT during STARTUP/recovery by default (engineering review H3).
# Staging override requires measured modem data: export QSD_TELEMETRY_STARTUP_UP=1
export QSD_TELEMETRY_STARTUP_UP="${QSD_TELEMETRY_STARTUP_UP:-0}"

# Provisioned modem IDs matching Spacetime's network model (never invent).
# Format: {"<beam_id|interface_id>": {"rx_modem_id": "...", "tx_modem_id": "..."}}
export QSD_MODEM_MAP="${QSD_MODEM_MAP:-${QSD_STATE_DIR}/modem_map.json}"

# Optional: hand non-beam schedule changes (routes, …) to the node's real backend.
# Without this, unhandled change types return UNIMPLEMENTED (12).
# export QSD_ENACT_CHAIN="/usr/local/bin/your-enact-backend"
